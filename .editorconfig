root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
tab_width = 4

Code style

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

Prefer explicit accessibility

dotnet_style_require_accessibility_modifiers = for_non_interface_members

Expression preferences

dotnet_style_prefer_collection_expression = true
dotnet_style_prefer_null_propagation = true
dotnet_style_coalesce_expression = true
dotnet_style_prefer_conditional_expression_over_assignment = true

Naming

dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface_types
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = interface_prefix

dotnet_naming_symbols.interface_types.applicable_kinds = interface
dotnet_naming_symbols.interface_types.applicable_accessibilities = *

dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.interface_prefix.capitalization = pascal_case

C# formatting

csharp_new_line_before_members_in_chained_methods = true
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true

csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

csharp_space_after_comma = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = false
csharp_space_after_colon_in_inheritance_clause = true

Braces

csharp_new_line_before_open_brace = all

var preferences

csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false

File-scoped namespaces

csharp_style_namespace_declarations = file_scoped

[*.json]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
